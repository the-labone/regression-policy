+            df = 1.0 / ((1.0 / _nu0) + ((1.0 / df) - (1.0 / _nu0)) * _pg)
+            if int(getattr(self, "_ht_iter", 0)) % 100 == 0 and (
+                (not torch.distributed.is_initialized()) or torch.distributed.get_rank() == 0):
+                print(f"[nu-anneal] iter {self._ht_iter}/{_tot} nu={df:.3f}", flush=True)
+        _hgs = int(getattr(self, "_ht_hg_steps", 0) or 0)
+        _in_hg = _hgs > 0 and int(getattr(self, "_ht_iter", 0)) < _hgs
+        if _hgs > 0 and getattr(self, "_ht_hg_last", None) != _in_hg:
+            self._ht_hg_last = _in_hg
+            print(f"[c3-hg] iter {getattr(self, '_ht_iter', 0)}: loss="
+                  f"{'HETERO-GAUSSIAN' if _in_hg else 'HETERO-T'} (hg_steps={_hgs})",
+                  flush=True)
+        losses = []
+        for i, (p, t) in enumerate(zip(pred, target)):
+            p32, t32 = p.float(), t.float()
+            r = t32 - p32  # [T, A]
+            mask = torch.ones_like(r)
+            cm = condition_mask[i]
+            if cm is not None:
+                m = cm.float().reshape(-1, 1)[: r.shape[0]]
+                mask = mask * (1.0 - m)  # 1 = noisy/generated, 0 = conditioning
+            if raw_action_dim is not None and raw_action_dim[i] is not None:
+                d = int(raw_action_dim[i])
+                if d < r.shape[-1]:
+                    mask[:, d:] = 0.0
+            d_eff = mask.sum().clamp(min=1.0)
+            sum_r2 = ((r * mask) ** 2).sum()
+            s_raw = self.net.llm2action_ht_sigma_head(p32.detach()).mean()
+            sigma = torch.nn.functional.softplus(s_raw + self._ht_sbias) + 1e-3
+            if getattr(self, "_ht_mse", False):
+                if not getattr(self, "_mse_banner", False):
+                    self._mse_banner = True
+                    print(f"[c3-mse] single-pass MSE control: 0.5*sum_r2, d_eff={float(d_eff)} (sigma head kept in graph, no gradient)", flush=True)
+                nll = 0.5 * sum_r2 + 0.0 * sigma          # + 0*sigma keeps the sigma head in the DDP graph
+            elif _in_hg:
+                nll = 0.5 * sum_r2 / sigma**2 + d_eff * torch.log(sigma)
+            elif getattr(self, "_ht_learn_nu", False):
+                n_raw = self.net.llm2action_ht_nu_head(p32.detach()).mean()
+                nu = torch.exp(0.6931471805599453
+                               + (9.010913347279288 - 0.6931471805599453)
+                               * torch.sigmoid(n_raw + 1.0986122886681098))
+                half = 0.5 * (nu + d_eff)
+                nll = half * torch.log1p(sum_r2 / (nu * sigma**2))                     + d_eff * torch.log(sigma)                     - torch.lgamma(half) + torch.lgamma(0.5 * nu)                     + 0.5 * d_eff * torch.log(nu)
+                if not hasattr(self, "_lnu_vals"):
+                    self._lnu_vals = []
+                self._lnu_vals.append(float(nu.detach()))
+                if len(self._lnu_vals) >= 400 and (
+                        (not torch.distributed.is_initialized()) or torch.distributed.get_rank() == 0):
+                    import numpy as _np
+                    _v = _np.array(self._lnu_vals); self._lnu_vals = []
+                    print(f"[c3-learnnu] nu q10/50/90 = {_np.percentile(_v,10):.1f}/"
+                          f"{_np.percentile(_v,50):.1f}/{_np.percentile(_v,90):.1f}", flush=True)
+            elif getattr(self, "_ht_mvt", False):
+                if not getattr(self, "_mvt_banner", False):
+                    self._mvt_banner = True
+                    print(f"[c3-mvt] multivariate Student-t: nu={df} (literal), d_eff={float(d_eff)}",
+                          flush=True)
+                nll = 0.5 * (df + d_eff) * torch.log1p(sum_r2 / (df * sigma**2)) \
+                    + d_eff * torch.log(sigma)
+            else:
+                nll = 0.5 * (df + 1.0) * torch.log1p(sum_r2 / (df * sigma**2 * d_eff)) * d_eff \
+                    + d_eff * torch.log(sigma)
+            _beta = float(getattr(self, "_ht_beta", 0.0))
+            _end = float(getattr(self, "_ht_beta_end_frac", 0.0))
+            _total = int(getattr(self, "_ht_max_iter", 0))
+            if _beta > 0.0 and _end > 0.0 and _total > 0:
+                _hold = float(getattr(self, "_ht_beta_hold_frac", 0.0))
+                _f = int(getattr(self, "_ht_iter", 0)) / _total
+                if _f > _hold:
+                    _beta = _beta * max(0.0, 1.0 - (_f - _hold) / max(1e-8, _end - _hold))
+            if _beta > 0.0 and not getattr(self, "_ht_mse", False):
