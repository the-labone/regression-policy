+    def _ht_action_loss_nurms(self, pred, target, condition_mask, raw_action_dim=None):
+        """Median-pinned gate: nu_t = c^2 * EMA[median(S/sigma^2)] (detached), mvt NLL."""
+        c = float(getattr(self, "_ht_nu_c", 2.5))
+        S, SIG, D = [], [], []
+        for i, (p, t) in enumerate(zip(pred, target)):
+            p32, t32 = p.float(), t.float()
+            r = t32 - p32
+            mask = torch.ones_like(r)
+            cm = condition_mask[i]
+            if cm is not None:
+                m = cm.float().reshape(-1, 1)[: r.shape[0]]
+                mask = mask * (1.0 - m)
+            if raw_action_dim is not None and raw_action_dim[i] is not None:
+                d = int(raw_action_dim[i])
+                if d < r.shape[-1]:
+                    mask[:, d:] = 0.0
+            D.append(mask.sum().clamp(min=1.0))
+            S.append(((r * mask) ** 2).sum())
+            s_raw = self.net.llm2action_ht_sigma_head(p32.detach()).mean()
+            SIG.append(torch.nn.functional.softplus(s_raw + self._ht_sbias) + 1e-3)
+        if not S:
+            return pred[0].sum() * 0.0
+        S_t, SIG_t, D_t = torch.stack(S), torch.stack(SIG), torch.stack(D)
+        u = (S_t / SIG_t ** 2).detach()
+        med = u.median()
+        ema = getattr(self, "_nu_ema", None)
+        self._nu_ema = med.clone() if ema is None else 0.99 * ema + 0.01 * med
+        nu = (c ** 2) * self._nu_ema
+        nll = 0.5 * (nu + D_t) * torch.log1p(S_t / (nu * SIG_t ** 2)) + D_t * torch.log(SIG_t)
+        out = (nll / D_t).mean()
+        self._nurms_calls = getattr(self, "_nurms_calls", 0) + 1
+        _r0 = (not torch.distributed.is_initialized()) or torch.distributed.get_rank() == 0
+        if _r0 and (self._nurms_calls == 1 or self._nurms_calls % 100 == 1):
+            _rms = float((S_t / D_t).mean().sqrt())
+            log.critical(f"[c3-nurms] call={self._nurms_calls} c={c} nu={float(nu):.1f} med_u={float(self._nu_ema):.1f} "
+                         f"frac_past_knee={float((u > nu).float().mean()):.3f} sigma={float(SIG_t.median()):.4f} "
+                         f"residual_rms={_rms:.4f} nll={float(out):.4f}")
+        return out
+
+    def _ht_action_loss(self, pred, target, condition_mask, raw_action_dim=None):
+        """Heteroscedastic Student-t NLL on the single-pass action residual.
